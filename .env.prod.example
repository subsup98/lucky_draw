# Copy this file to .env.prod on the server. Never commit .env.prod.

# Public domains. Use one domain split into subdomains.
ROOT_DOMAIN=example.com
USER_DOMAIN=www.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# Postgres container credentials.
POSTGRES_USER=lucky_draw
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=lucky_draw

# Backend runtime.
JWT_ACCESS_SECRET=change-me-64-random-chars
JWT_ACCESS_TTL=15m
ADMIN_JWT_ACCESS_SECRET=change-me-different-64-random-chars
ADMIN_JWT_ACCESS_TTL=15m
REFRESH_TTL_SECONDS=1209600
ADMIN_REFRESH_TTL_SECONDS=86400
COOKIE_SECURE=false
TOTP_ISSUER=LuckyDraw Admin

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-base64-32-bytes
ENCRYPTION_STRICT=true

# First admin seed/reset values. Use once, then rotate the password.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-admin-password

# Payment. Keep mock until Toss production keys and webhook URLs are ready.
PAYMENT_PROVIDER=mock
PAYMENT_INTENT_SECRET=change-me-payment-intent-secret
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# Email notification provider.
EMAIL_PROVIDER=gmail
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Lucky Draw
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true

# Kakao OAuth. Update redirect URI after DNS/HTTPS is ready.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://api.example.com/api/auth/oauth/kakao/callback
APP_DEEP_LINK=luckydraw://oauth/done
